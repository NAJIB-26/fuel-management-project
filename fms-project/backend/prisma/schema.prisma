generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
}

enum TruckStatus {
  ACTIVE
  IN_MAINTENANCE
  SOLD
}

enum FuelType {
  GASOLINE
  DIESEL
}

enum ApprovalStatus {
  APPROVED
  REJECTED
  PENDING
}

enum PeriodicMaintenanceKind {
  ENGINE_OIL
  GEARBOX_OIL
  DIFFERENTIAL_OIL
  POWER_STEERING_OIL
  BRAKE_PAD
  OIL_FILTER
  DIESEL_FILTER
  DIESEL_FILTER_METAL
  AIR_FILTER
  RADIATOR_WATER
  TIRES
  WASHING
  PERIODIC_INSPECTION
}

model User {
  id           String         @id @default(uuid())
  employeeNo   Int            @unique @default(autoincrement())
  addedDate    DateTime       @default(now())
  fullName     String
  jobLevel     String
  department   String
  status       EmployeeStatus @default(ACTIVE)
  username     String         @unique
  passwordHash String
  managedById  String?
  managedBy    User?          @relation("DirectManager", fields: [managedById], references: [id])
  reports      User[]         @relation("DirectManager")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  permissions      Permission?
  fuelRequests     FuelRequest[]                 @relation("FuelRequestCreator")
  periodicRequests PeriodicMaintenanceRequest[]  @relation("PeriodicRequestCreator")
  generalRequests  GeneralMaintenanceRequest[]   @relation("GeneralRequestCreator")
  deviceTokens     DeviceToken[]
  auditLogs        AuditLog[]
  notifications    Notification[]
}

model Permission {
  id                     String   @id @default(uuid())
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String   @unique
  isSystemAdmin          Boolean  @default(false)
  tabPermissions         Json     @default("[]")
  screenPermissions      Json     @default("[]")
  canAdd                 Boolean  @default(false)
  canEdit                Boolean  @default(false)
  canPrint               Boolean  @default(false)
  canViewReports         Boolean  @default(false)
  canApproveLevel1       Boolean  @default(false)
  canApproveLevel2       Boolean  @default(false)
  financialApprovalLimit Decimal? @db.Decimal(12, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Truck {
  id                 String      @id @default(uuid())
  name               String
  model              String
  yearMade           Int
  plateNo            String      @unique
  tankCapacityLiters Decimal     @db.Decimal(10, 2)
  fuelType           FuelType
  engineOilType      String?
  imageUrl           String?
  status             TruckStatus @default(ACTIVE)
  insuranceExpiry    DateTime?
  licenseExpiry      DateTime?
  lastFuelOdometer   Decimal?    @db.Decimal(12, 2)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  maintenanceLimits TruckMaintenanceLimit[]
  fuelRequests      FuelRequest[]
  periodicRequests  PeriodicMaintenanceRequest[]
  generalRequests   GeneralMaintenanceRequest[]
}

model TruckMaintenanceLimit {
  id           String                   @id @default(uuid())
  truck        Truck                    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  truckId      String
  kind         PeriodicMaintenanceKind
  limitKm      Decimal                  @db.Decimal(12, 2)
  lastOdometer Decimal?                 @db.Decimal(12, 2)

  @@unique([truckId, kind])
}

model FuelRequest {
  id                String         @id @default(uuid())
  requestNo         Int            @unique @default(autoincrement())
  date              DateTime       @default(now())
  requestedBy       User           @relation("FuelRequestCreator", fields: [requestedById], references: [id])
  requestedById     String
  department        String
  truck             Truck          @relation(fields: [truckId], references: [id])
  truckId           String
  fuelType          FuelType
  requestedQuantity Decimal        @db.Decimal(12, 2)
  unit              String
  unitPrice         Decimal?       @db.Decimal(12, 2)
  totalAmount       Decimal?       @db.Decimal(14, 2)
  currentOdometer   Decimal        @db.Decimal(12, 2)
  previousOdometer  Decimal        @db.Decimal(12, 2)
  odometerDiff      Decimal        @db.Decimal(12, 2)
  consumptionRate   Decimal?       @db.Decimal(12, 4)
  attachmentUrl     String?
  directApproval    ApprovalStatus @default(PENDING)
  serviceApproval   ApprovalStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model PeriodicMaintenanceRequest {
  id              String                   @id @default(uuid())
  requestNo       Int                      @unique @default(autoincrement())
  date            DateTime                 @default(now())
  requestedBy     User                     @relation("PeriodicRequestCreator", fields: [requestedById], references: [id])
  requestedById   String
  department      String
  truck           Truck                    @relation(fields: [truckId], references: [id])
  truckId         String
  kind            PeriodicMaintenanceKind
  currentOdometer Decimal                  @db.Decimal(12, 2)
  lastOdometer    Decimal                  @db.Decimal(12, 2)
  odometerDiff    Decimal                  @db.Decimal(12, 2)
  quantity        Decimal                  @db.Decimal(12, 2)
  unit            String
  withinLimit     Boolean
  approvalL1      ApprovalStatus           @default(PENDING)
  approvalL2      ApprovalStatus           @default(PENDING)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
}

model GeneralMaintenanceRequest {
  id               String         @id @default(uuid())
  requestNo        Int            @unique @default(autoincrement())
  date             DateTime       @default(now())
  requestedBy      User           @relation("GeneralRequestCreator", fields: [requestedById], references: [id])
  requestedById    String
  department       String
  truck            Truck          @relation(fields: [truckId], references: [id])
  truckId          String
  currentOdometer  Decimal        @db.Decimal(12, 2)
  lastOdometer     Decimal        @db.Decimal(12, 2)
  faultType        String
  faultDescription String
  estimatedCost    Decimal        @db.Decimal(12, 2)
  requiredParts    String?
  attachmentUrl    String?
  approvalL1       ApprovalStatus @default(PENDING)
  approvalL2       ApprovalStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model MaintenanceTypeCode {
  id       String @id @default(uuid())
  name     String
  category String
}

model FaultTypeCode {
  id   String @id @default(uuid())
  name String
}

model Vendor {
  id      String  @id @default(uuid())
  name    String
  type    String
  address String?
  phone   String?
}

model Unit {
  id          String @id @default(uuid())
  unitNo      Int    @unique @default(autoincrement())
  description String
  status      String @default("ACTIVE")
}

model Company {
  id      String   @id @default(uuid())
  name    String
  logoUrl String?
  address String?
  phones  String[]
}

model DeviceToken {
  id       String @id @default(uuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  token    String @unique
  platform String
}

model AuditLog {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ErrorCode {
  id          String @id @default(uuid())
  code        String @unique
  description String
  solution    String
}
